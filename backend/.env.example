KYC_MODE=demo
KYC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
KYC_SESSION_TTL_SECONDS=600
KYC_MAX_SESSIONS=100
KYC_LOG_LEVEL=INFO

# Example thresholds only: validate against your held-out deployment dataset.
KYC_APPROVE_SIMILARITY=0.70
KYC_REJECT_SIMILARITY=0.45
KYC_CONTINUITY_SIMILARITY=0.65
KYC_DOCUMENT_CONFIDENCE=0.85
KYC_PAD_LIVE_THRESHOLD=0.90
KYC_THRESHOLDS_CALIBRATED=false

# All four are required with KYC_MODE=model. Paths are relative to backend/.
# KYC_FACE_MODEL_PATH=weights/facenet.ts
# KYC_DOCUMENT_MODEL_PATH=weights/document.ts
# KYC_PAD_MODEL_PATH=weights/pad.ts
# KYC_LANDMARK_MODEL_PATH=weights/face_landmarker.task
KYC_DEVICE=cpu

